@{var stt = 0;}

@model List<CNTT35.Data.Fn_GetCTSP_Result>
<table class="table">
    <tr>
        <th>STT</th>
        <th>Tên Sản Phẩm</th>
        <th>Số Lượng</th>
        <th>Đơn Giá</th>
    </tr>
    @foreach (var ct in Model)
    {
        stt++;
        <tr>
            <td>@stt</td> 
            <td>@ct.TENSP</td>
            <td style="text-align:right">@ct.SOLUONGSP</td>
            <td>@string.Format("{0:#,### đ}", @ct.DONGIA)</td>
        </tr>
    }
</table>
