                                <div class="main2">
                                    <div  style="display: flex;justify-content: space-evenly;">
                                    <div>Bùi Bá Lộc</div> 
                                    <div style="color: rgba(0,0,0,.4);">(+84) 333380274</div>
                                    <div data-toggle="modal"
                                          data-target="#exampleModalEditAddAdress" 
                                          style="color: #007B5E;margin-left: 1rem;cursor: pointer;"> Chỉnh sửa
                                     </div>
                                    </div>
                                    <div style="color: rgba(0,0,0,.4);"> 76 Trần Văn Dư</div>
                                    <div> <span style="color: rgba(0,0,0,.4);">Phường 13, Tân Bình, Hồ Chí Minh</span></div>
                                </div>
                                
                            </div>
                             <hr>
                            </div>
                              <div>
                             <div class="people" style="display: flex;justify-content: space-evenly;margin: 1rem 0rem 1rem;">
                                <a class="shopee-product-rating__avatar">
                                <div class="shopee-avatar">
                                    <div class="shopee-avatar__placeholder">
                                  <input value="" class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2"  checked="">
                                        </div>
                                    </div>
                                </a>
                                <div class="main2">
                                    <div  style="display: flex;justify-content: space-evenly;">
                                    <div>Bùi Bá Lộc</div> 
                                    <div style="color: rgba(0,0,0,.4);">(+84) 333380274</div>
                                    <div data-toggle="modal"
                                          data-target="#exampleModalEditAddAdress" 
                                          style="color: #007B5E;margin-left: 1rem;cursor: pointer;"> Chỉnh sửa
                                     </div>
                                    </div>
                                    <div style="color: rgba(0,0,0,.4);"> 76 Trần Văn Dư</div>
                                    <div> <span style="color: rgba(0,0,0,.4);">Phường 13, Tân Bình, Hồ Chí Minh</span></div>
                                </div>
                                
                            </div>
                             <hr>
                            </div>
                            
                        </form>
                    <a data-toggle="modal"
                        data-target="#exampleModalAddAdress" class="primary-btn cart-btn" style="text-transform: none;text-decoration: none;margin-top: 1rem; ">
                    <i class="bi bi-plus-lg"></i>
                    Thêm địa chỉ mới</a>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Trở lại
                    </button>
                    <button type="submit" class="btn btn-primary" style="background: #007B5E; color:#fff;">Hoàn thành</button>
                </div>
            </div>



        </div>
    </div>
