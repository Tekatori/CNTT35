@model CNTT35.ViewModel.GioHang
@{
    ViewBag.Title = "Confirm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var khach = ViewBag.kh as List<CNTT35.Service.Model.AccountInfo>;
    var dc = ViewBag.dc as List<CNTT35.Data.getDiaChiKhac_Result>;
    var dIACHIKHAC = ViewBag.dck as CNTT35.Data.DIACHIKHAC;
}
@{
           var parameter = Request.QueryString["ac"];
    //Check parameter here and display Message
    if (parameter == "error")
    {
        <div class="alert alert-success alert-dismissable" style="text-align:center">
            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
            <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i>Hãy Nhập Đủ Thông tin,Làm ơn!</strong>
        </div>
    }
}
<section class="checkout spad">
    <div class="container">
        <div class="checkout__form">
            <h4>Chi tiết thanh toán</h4>
            @using (Html.BeginForm("paymentSucces", "Cart", FormMethod.Post))
            {
                    <div class="row">
                        <div class="col-lg-8 col-md-6">
                            @if (dIACHIKHAC == null)
                            {
        
                                foreach (var item in khach)
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="checkout__input">
                                                <p>Họ Tên</p>
                                                <input type="text" value="@item.HOTEN" disabled>
                                                <input type="text" value="@item.HOTEN" name="hoten" readonly="" hidden>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="checkout__input">
                                        <div style="display:flex;">
                                            <p>Địa chỉ<span>*</span></p>
                                            <div data-toggle="modal"
                                                 data-target="#exampleModalChangeAdress"
                                                 style="color: #007B5E;margin-left: 1rem;cursor: pointer;">
                                                Thay đổi
                                            </div>
                                        </div>
                                        <input type="text" value="@item.DIACHI" disabled>
                                        <input name="diachi" type="text" placeholder="Địa chỉ số nhà, đường phố" class="checkout__input__add" value="@item.DIACHI" readonly="readonly" hidden />

                                    </div>



                                    <div class="row">
                                        <div class="col-lg-6">
                                            <div class="checkout__input">
                                                <p>Điện thoại<span>*</span></p>
                                                <input type="text" value="@item.SDT" disabled>
                                                <input type="text" value="@item.SDT" name="phone" readonly="readonly" hidden>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="checkout__input">
                                                <p>Email<span>*</span></p>
                                                <input type="text" value="@item.EMAIL" disabled>
                                                <input type="text" value="@item.EMAIL" name="email" readonly="readonly" hidden>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="checkout__input">
                                        <p>Ghi chú<span></span></p>
                                        <input type="text" placeholder="Ghi chú về đơn đặt hàng của bạn, ví dụ: Hàng dễ vỡ" name="ghichu">
                                    </div>

                                    <p>Phương thức vận chuyển<span style="color:red;">*</span></p>
                                    <div style="display: flex;margin-bottom: 1rem;">
                                        <div class="form-check">
                                            <input value="Tiết kiệm" class="form-check-input " type="radio" name="flexRadioDefault" id="flexRadioDefault1" onclick="myFunction()">
                                            <label class="form-check-label" for="flexRadioDefault1">
                                                Tiết kiệm
                                                <span> (7 ngày) </span>
                                            </label>

                                        </div>
                                        <div class="form-check" style="margin-left:1rem ;">
                                            <input value="Hỏa tốc" class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2 " onclick="myFunction()" checked>
                                            <label class="form-check-label" for="flexRadioDefault2">
                                                Hỏa tốc
                                                <span> (3 ngày) </span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
          
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="checkout__input">
                                            <p>Họ Tên</p>
                                            <input type="text" value="@dIACHIKHAC.HOTEN" disabled>
                                            <input type="text" value="@dIACHIKHAC.HOTEN" name="hoten" readonly="readonly" hidden>
                                        </div>
                                    </div>

                                </div>
                                <div class="checkout__input">
                                    <div style="display:flex;">
                                        <p>Địa chỉ<span>*</span></p>
                                        <div data-toggle="modal"
                                             data-target="#exampleModalChangeAdress"
                                             style="color: #007B5E;margin-left: 1rem;cursor: pointer;">
                                            Thay đổi
                                        </div>
                                    </div>
                                    <input type="text" value="@dIACHIKHAC.DIACHI" disabled>
                                    <input name="diachi" type="text" placeholder="Địa chỉ số nhà, đường phố" class="checkout__input__add" value="@dIACHIKHAC.DIACHI" readonly="readonly" hidden />

                                </div>



                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="checkout__input">
                                            <p>Điện thoại<span>*</span></p>
                                            <input type="text" value="@dIACHIKHAC.SDT" disabled>
                                            <input type="text" value="@dIACHIKHAC.SDT" name="phone" readonly="readonly" hidden>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="checkout__input">
                                            <p>Email<span>*</span></p>
                                            <input type="text" value="@CNTT35.Session.LoginSession.GetSessionInfoLogin().EMAIL" disabled>
                                            <input type="text" value="@CNTT35.Session.LoginSession.GetSessionInfoLogin().EMAIL" name="email" readonly="readonly" hidden>
                                        </div>
                                    </div>
                                </div>

                                <div class="checkout__input">
                                    <p>Ghi chú<span></span></p>
                                    <input type="text" placeholder="Ghi chú về đơn đặt hàng của bạn, ví dụ: Hàng dễ vỡ" name="ghichu">
                                </div>

                                <p>Phương thức vận chuyển<span style="color:red;">*</span></p>
                                <div style="display: flex;margin-bottom: 1rem;">
                                    <div class="form-check">
                                        <input value="Tiết kiệm" class="form-check-input " type="radio" name="flexRadioDefault" id="flexRadioDefault1" onclick="myFunction()">
                                        <label class="form-check-label" for="flexRadioDefault1">
                                            Tiết kiệm
                                            <span> (7 ngày) </span>
                                        </label>

                                    </div>
                                    <div class="form-check" style="margin-left:1rem ;">
                                        <input value="Hỏa tốc" class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2 " onclick="myFunction()" checked>
                                        <label class="form-check-label" for="flexRadioDefault2">
                                            Hỏa tốc
                                            <span> (3 ngày) </span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="col-lg-4 col-md-6">

                            <div class="checkout__order">
                                <h4>Đơn đặt hàng của bạn</h4>
                                <div class="checkout__order__products">Các sản phẩm <span>Giá tiền</span></div>

                                <ul>
                                    @foreach (CNTT35.ViewModel.CartItem item in Model.ds)
                                    {
                                        if (item.iSoLuong > 0)
                                        {
                                            var tensp = item.sTenSP;
                                            <li>@item.iSoLuong x @tensp.Substring(10) <span>@string.Format("{0:#,### đ}", item.ThanhTien)</span></li>
                                        }
                                    }
                                </ul>
                                <div class="checkout__order__products " style="display: none;" id="option1">Phí vận chuyển <span>20.000₫</span></div>
                                <div class="checkout__order__products " id="option2">Phí vận chuyển <span>35.000₫</span></div>

                                <div class="checkout__order__subtotal">Tổng thu <span>@string.Format("{0:#,### đ}", @Model.TongThanhTien() + 35000)  </span></div>
                                @if (TempData["tienkm"].ToString() != "0")
                                {
                                    <div class="checkout__order__total">Số tiền giảm <span>@string.Format("{0:#,### đ}", TempData["tienkm"])</span></div>
                                }
                                else
                                {
                                    <div class="checkout__order__total">Số tiền giảm <span>0 đ</span></div>
                                }
                                @if (TempData["sum"].ToString() != "0")
                                {
                                    <div class="checkout__order__total">Thành tiền <span>@string.Format("{0:#,### đ}", double.Parse(TempData["sum"].ToString()) + 35000)</span></div>
                                }
                                else
                                {
                                    <div class="checkout__order__total">Thành tiền <span>@string.Format("{0:#,### đ}", @Model.TongThanhTien() + 35000)</span></div>
                                }

                                <div class="checkout__input__checkbox">
                                    <label for="payment">
                                        Thanh toán khi nhận hàng
                                        <input type="checkbox" id="payment" name="thanhtoan" value="TrucTiep" checked>
                                        <span class="checkmark"></span>
                                    </label>
                                </div>
                                <div class="checkout__input__checkbox">
                                    <label for="paypal">
                                        Thanh toán trực tuyến
                                        <input type="checkbox" id="paypal" name="thanhtoan" value="Online">
                                        <span class="checkmark"></span>
                                    </label>
                                </div>

                                <button type="submit" class="site-btn">XÁC NHẬN</button>

                            </div>

                        </div>
                    </div>
            }
            </div>
    </div>
</section>

     <!-- Modal Change Adress-->
    <div class="modal fade"
         id="exampleModalChangeAdress"
         tabindex="-1"
         role="dialog"
         aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            @using (Html.BeginForm("Confirm", "Cart", FormMethod.Post))
            {
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Địa chỉ của tôi   </h5>
                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="sl-container">
                            <div class="sl-wrapper">
                            </div>
                        </div>

                        <div>
                            <div class="people" style="display: flex;justify-content: space-evenly;margin: 1rem 0rem 1rem;">
                                <a class="shopee-product-rating__avatar">
                                    <div class="shopee-avatar">
                                        <div class="shopee-avatar__placeholder">
                                            <input value="0" class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2 ">
                                        </div>
                                    </div>
                                </a>
                                <div class="main2">
                                    <div style="display: flex;justify-content: space-evenly;">
                                        <div>Mặc Định</div>
                                    </div>                     
                                </div>

                            </div>
                            <hr>
                            @foreach (var dck in dc)
                            {
                                <div class="people" style="display: flex;justify-content: space-evenly;margin: 1rem 0rem 1rem;">
                                    <a class="shopee-product-rating__avatar">
                                        <div class="shopee-avatar">
                                            <div class="shopee-avatar__placeholder">
                                                <input value="@dck.IDDC" class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault2 ">
                                            </div>
                                        </div>
                                    </a>
                                    <div class="main2">
                                        <div style="display: flex;justify-content: space-evenly;">
                                            <div>@dck.HOTEN</div>
                                            <div style="color: rgba(0,0,0,.4);">(+84) @dck.SDT</div>
                                        </div>
                                        <div> <span style="color: rgba(0,0,0,.4);">@dck.DIACHI</span></div>
                                    </div>

                                </div>
                                <hr>
                            }

                        </div>
                        <a  href="/Home/addNewAdress"  class="primary-btn cart-btn" style="text-transform: none;text-decoration: none;margin-top: 1rem; ">
                            <i class="bi bi-plus-lg"></i>
                            Thêm địa chỉ mới
                        </a>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">
                            Trở lại
                        </button>
                        <button type="submit" class="btn btn-primary" style="background: #007B5E; color:#fff;">Hoàn thành</button>
                    </div>
                </div>
                }


            </div>
    </div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.21.1/axios.min.js"></script>



