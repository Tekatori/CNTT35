<!-- Shoping Cart Section Begin -->
    <section class="">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="shoping__cart__table">
                        <table>
                            <thead>
                                <tr>
                                    <th class="shoping__product">Sản phẩm</th>
                                    <th>Giá tiền</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CNTT35.ViewModel.CartItem item in Model.ds)
                                {
                                    if (item.iSoLuong > 0)
                                    {
                                        string[] listHinhAnh = item.sAnh.ToString().Split(',');
                                        <tr>
                                            <td class="shoping__cart__item">
                                                <img src="~/Content/img/featured/@listHinhAnh[0].ToString()" alt="">
                                                <h5>@item.sTenSP</h5>
                                            </td>
                                            <td class="shoping__cart__price">
                                                @string.Format("{0:#,### đ}", item.dDonGia)
                                            </td>
                                            @*class="shoping__cart__quantity"*@
                                            <td>
                                                <form id='myform' method='POST' class='quantity' action='#'>
                                                    <div class="quantity-form">
                                                        <input type='button' value='-' class='qtyminus minus' field='quantity' onclick="location.href='@Url.Action("DesSL/" + @item.iMaSP, "Cart")'" />
                                                        <input type='text' name='quantity' value='@item.iSoLuong' class='qty' />
                                                        <input type='button' value='+' class='qtyplus plus' field='quantity' onclick="location.href='@Url.Action("AddSL/" + @item.iMaSP, "Cart")'" />
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="shoping__cart__total">
                                                @string.Format("{0:#,### đ}", item.ThanhTien)
                                            </td>

                                            <td class="shoping__cart__item__close">
                                                <a onclick="return confirmAction()" href="/Cart/DeleteSP/@item.iMaSP">
                                                    <script type="text/javascript">
                                                        function confirmAction() {
                                                            return confirm("Bạn Muốn xoá sản phẩm này khỏi giỏ hàng không?")
                                                        }
                                                    </script>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                                    </svg>
                                                </a>
                                            </td>
                                        </tr>

                                    }

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="shoping__cart__btns">
                        <a href="../Product" class="primary-btn cart-btn">Tiếp tục mua sắm</a>
                        <a href="/Cart/XoaGio" class="primary-btn cart-btn cart-btn-right" onclick="return confirmAction2()">
                            <script type="text/javascript">
                                function confirmAction2() {
                                    return confirm("Bạn Muốn xoá tất cả sản phẩm khỏi giỏ hàng không?")
                                }
                            </script>
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                            <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5ZM11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H2.506a.58.58 0 0 0-.01 0H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1h-.995a.59.59 0 0 0-.01 0H11Zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5h9.916Zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47ZM8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5Z"/>
                            </svg>
                            Xoá giỏ hàng
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="shoping__continue">
                        <div class="shoping__discount">
                            <h5>Mã giảm giá</h5>
                            @using (Html.BeginForm("GiamGia", "Cart", FormMethod.Post))
                            {
                                <input type="text" name="magiam" placeholder="Nhập Voucher ở đây">
                                <button type="submit" class="site-btn">Áp dụng Voucher</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="shoping__checkout">
                        <h5>Tổng tiền</h5>
                        <ul>
                            <li>Tổng<span> @string.Format("{0:#,### đ}", Model.TongThanhTien())</span></li>
                            @if (@Session["giamgia"] == null)
                            {
                                Session["tien"] = 0;
                                Session["tienKM"] = 0;
                                <li>Tổng cộng <span>@string.Format("{0:#,### đ}", Model.TongThanhTien())</span></li>
                            }
                            else
                            {
                                Session["tien"] = Session["giamgia"];
                                Session["tienKM"] = Model.TongThanhTien() - double.Parse(Session["giamgia"].ToString());
                                 <li>Mã giảm giá<span>-20,000 đ </span></li>
                                <li>Tổng cộng <span>@string.Format("{0:#,### đ}", Session["giamgia"])</span></li>
                            }
                        </ul>
                        <a href="../Cart/Confirm" class="primary-btn">Xác nhận thanh toán</a>
                    </div>
                </div>
            </div>
            @{
                var parameter2 = Request.QueryString["ac147"];
                //Check parameter here and display Message
                if (parameter2 == "error147")
                {
                    <div class="alert alert-success alert-dismissable" style="text-align:center">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i>Không có gì trong Giỏ Hàng !</strong>
                    </div>
                }
                else if (parameter2 == "usernull")
                {
                    <div class="alert alert-success alert-dismissable" style="text-align:center; margin-top:2rem;">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i>Bạn chưa đăng nhập,làm ơn hãy đăng nhập để tiếp tục</strong>
                    </div>
                }

            }
        </div>
    </section>
<!-- Shoping Cart Section End -->
@Scripts.Render("~/Content/js/main.js")

