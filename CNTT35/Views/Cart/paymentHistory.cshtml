
@{
    ViewBag.Title = "paymentHistory";
    int stt = 0;
    int stt2 = 0;
    int sttcgh = 0;
    int sttdhth = 0;
}
@using PagedList.Mvc;
@using PagedList;
@model IPagedList<CNTT35.Data.LichSuMuaHang_Result>
<style>
    .cycle-tab-container {
        margin: 30px auto;
        width: 1122px;
        height: 500px;
        padding: 20px;
        box-shadow: 0 0 10px 2px #ddd;
    }

        .cycle-tab-container a {
            color: #173649;
            font-size: 16px;
            font-family: roboto;
            text-align: center;
        }

    .tab-pane {
        text-align: center;
        height: 100px !important;
        margin: 30px auto;
        max-width: 100%;
    }

    .fade {
        opacity: 0;
        transition: opacity 4s ease-in-out;
    }

        .fade.active {
            opacity: 1;
        }

    .cycle-tab-item {
        width: 180px;
    }

        .cycle-tab-item:after {
            display: block;
            content: '';
            border-bottom: solid 3px #007B5E;
            transform: scaleX(0);
            transition: transform 0ms ease-out;
        }

        .cycle-tab-item.active:after {
            transform: scaleX(1);
            transform-origin: 0% 50%;
            transition: transform 5000ms ease-in;
        }


        .nav-link:focus,
        .nav-link:hover,
        .cycle-tab-item.active a {
            border-color: transparent !important;
            color: orange;
        }
</style>

<section class="checkout spad">
 
    <div class="container">
        <div class="checkout__form">
            <h4>Thông tin đơn hàng</h4>

            <span style="color:red;">*</span>
            <span> Chọn để xem tất cả sản phẩm đã mua trong đơn hàng </span>

        </div>
    </div>

    <div class="container">
        <div class="cycle-tab-container">
            <ul class="nav nav-tabs">
                <li class="cycle-tab-item active">
                    <a class="nav-link" role="tab" data-toggle="tab" href="#home">Tất cả đơn hàng</a>
                </li>
                <li class="cycle-tab-item">
                    <a class="nav-link" role="tab" data-toggle="tab" href="#notDelivery">Đơn hàng chưa giao</a>
                </li>
                <li class="cycle-tab-item">
                    <a class="nav-link" role="tab" data-toggle="tab" href="#profile">Đơn mua thành công</a>
                </li>

            </ul>
            <div class="tab-content">
                <div class="tab-pane fade active in" id="home" role="tabpanel" aria-labelledby="home-tab">
                    <table class="table ">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">ID đơn hàng</th>
                                <th scope="col">Sản phẩm mua</th>
                                <th scope="col">Tên khách hàng</th>
                                <th scope="col">Ngày tạo đơn</th>
                                <th scope="col">Trạng thái đơn hàng</th>
                                <th scope="col">Tổng tiền</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {
                            stt = stt + 1;
                            <tbody>
                                <tr>
                                    <th scope="row">@stt</th>
                                    <td>@item.IDDH</td>
                                    <td style="text-align:center">
                                        <div class="navbar" style="padding:0px;margin-left: 3rem;">
                                            <div class="dropdown" style="padding:0px">
                                                <a href="#" id="menudrop" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="text-decoration: none;"><span style="color:red;">*</span><u style="text-align:center;text-decoration: none;color: #007B5E;font-weight: 700;"> Chi Tiết</u> </a>
                                                <div class="dropdown-menu" aria-labelledby="menudrop" style="padding:0px;width: max-content;">
                                                    @Html.Action("HienTenSP", "Cart", new { iddh = @item.IDDH })
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.HOTEN</td>
                                    <td>@item.NGAYLAP.Value.ToString("dd/MM/yyyy")</td>
                                    @if (@item.NGAYGIAOHANG != null)
                                    {
                                        <td><input type="checkbox" checked disabled />Đã Giao</td>

                                    }
                                    else if (item.NGAYGIAOHANG == null && item.TrangThai != "Đã Huỷ")
                                    {
                                        <td><input type="checkbox" disabled />Chưa Giao</td>

                                    }
                                    else
                                    {
                                        <td><input type="checkbox" checked disabled />Đã Huỷ</td>
                                    }
                                    <td>@string.Format("{0:#,### đ}", @item.THANHTIEN) </td>

                                </tr>
                            </tbody>
                        }
                    </table>
                </div>
                <div class="tab-pane fade" id="notDelivery" role="tabpanel" aria-labelledby="notDelivery-tab">
                    <table class="table ">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">ID đơn hàng</th>
                                <th scope="col">Sản phẩm mua</th>
                                <th scope="col">Tên khách hàng</th>
                                <th scope="col">Ngày tạo đơn</th>
                                <th scope="col">Trạng thái đơn hàng</th>
                                <th scope="col">Tổng tiền</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {

                            if (item.NGAYGIAOHANG == null && item.TrangThai != "Đã Huỷ")
                            {
                                sttcgh++;
                                <tbody>
                                    <tr>
                                        <th scope="row">@sttcgh</th>
                                        <td>@item.IDDH</td>
                                        <td style="text-align:center">
                                            <div class="navbar" style="padding:0px;margin-left: 3rem;">
                                                <div class="dropdown" style="padding:0px">
                                                    <a href="#" id="menudrop" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="text-decoration: none;"><span style="color:red;">*</span><u style="text-align:center;text-decoration: none;color: #007B5E;font-weight: 700;">Chi Tiết</u> </a>
                                                    <div class="dropdown-menu" aria-labelledby="menudrop" style="padding:0px;width: max-content;">
                                                        @Html.Action("HienTenSP", "Cart", new { iddh = @item.IDDH })
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.HOTEN</td>
                                        <td>@item.NGAYLAP.Value.ToString("dd/MM/yyyy")</td>
                                        @if (item.TrangThai == "Chờ Huỷ")
                                        {
                                            <td>Đang chờ huỷ</td>
                                            <td>@string.Format("{0:#,### đ}", @item.THANHTIEN) </td>
                                            <td><a class="btn btn-success" href="/Cart/HoanTacHuy/@item.IDDH">Hoàn tác huỷ</a></td>
                                        }
                                        else
                                        {
                                            <td>Đang chờ giao</td>
                                            <td>@string.Format("{0:#,### đ}", @item.THANHTIEN) </td>
                                            <td><a class="btn btn-danger" href="/Cart/YeuCauHuy/@item.IDDH">Yêu cầu huỷ</a></td>
                                        }



                                    </tr>
                                </tbody>
                            }
                        }
                    </table>
                </div>
                <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                    <table class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">ID đơn hàng</th>
                                <th scope="col">Sản phẩm mua</th>
                                <th scope="col">Tên khách hàng</th>
                                <th scope="col">Ngày tạo đơn</th>
                                <th scope="col"> Ngày Vận Chuyển</th>
                                <th scope="col">Ngày Giao</th>
                                <th scope="col">Tổng tiền</th>

                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {

                            if (item.NGAYGIAOHANG != null)
                            {
                                sttdhth = sttdhth + 1;
                                <tbody>
                                    <tr>
                                        <th scope="row">@sttdhth</th>
                                        <td>@item.IDDH</td>
                                        <td style="text-align:center">
                                            <div class="navbar" style="padding:0px;margin-left: 3rem;">
                                                <div class="dropdown" style="padding:0px">
                                                    <a href="#" id="menudrop" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="text-decoration: none;"><span style="color:red;">*</span><u style="text-align:center;text-decoration: none;color: #007B5E;font-weight: 700;">Chi Tiết</u> </a>
                                                    <div class="dropdown-menu" aria-labelledby="menudrop" style="padding:0px;width: max-content;">
                                                        @Html.Action("HienTenSP", "Cart", new { iddh = @item.IDDH })
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.HOTEN</td>
                                        <td>@item.NGAYLAP.Value.ToString("dd/MM/yyyy")</td>
                                        <td>@item.NGAYVANCHUYEN.Value.ToString("dd/MM/yyyy")</td>
                                        <td>@item.NGAYGIAOHANG.Value.ToString("dd/MM/yyyy")</td>
                                        <td>@string.Format("{0:#,### đ}", @item.THANHTIEN)</td>
                                    </tr>
                                </tbody>
                            }
                        }
                    </table>
                </div>


            </div>

        </div>
        <div class="product__pagination">
            @Html.PagedListPager(Model, page => Url.Action("paymentHistory", new { page }))
        </div>
    </div>

    <div class="col-lg-12 container">
        <div class="shoping__cart__btns">
            <a href="../Product" class="primary-btn cart-btn">Tiếp tục mua sắm</a>
            <a href="../Home" class="primary-btn cart-btn cart-btn-right" style="margin-left: 2rem;">

                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                </svg>
                Quay về trang chủ
            </a>
        </div>
    </div>
</section>

