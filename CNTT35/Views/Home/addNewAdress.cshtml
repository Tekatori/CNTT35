 <!-- Modal add Adress-->
    <div class="modal fade"
         id="exampleModalAddAdress"
         tabindex="-1"
         role="dialog"
         aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Thêm địa chỉ mới  </h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="sl-container">
                        <div class="sl-wrapper">
                            <div class="sl-vertical social-wrap oxi_icon_center login">

                            </div>
                        </div>
                    </div>
                    <form>
                        <div class="form-group">

                            <input placeholder="Họ tên" class="form-control custom-input" name="edit-yourname" id="edit-yourname" />
                        </div>
                        <div class="form-group">

                            <input placeholder="Số điện thoại" class="form-control custom-input" name="edit-numberphone" id="edit-numberphone" />
                        </div>

                        <div class="form-group">

                            <input placeholder="Thành phố/ tỉnh" class="form-control custom-input" name="edit-city" id="edit-city" />
                        </div>
                         <div class="form-group">

                            <input placeholder="Quận/ huyện" class="form-control custom-input" name="edit-district" id="edit-district" />
                        </div>
                         <div class="form-group">

                            <input placeholder="Phường/ xã" class="form-control custom-input" name="edit-ward" id="edit-ward" />
                        </div>
                         <div class="form-group">

                            <input placeholder="Địa chỉ cụ thể" class="form-control custom-input" name="edit-address" id="edit-address" />
                        </div>



                        
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Trở lại
                    </button>
                    <button type="button" class="btn btn-primary" style="background: #007B5E; color:#fff;">Hoàn thành</button>
                </div>
            </div>



        </div>
    </div>
    <!-- ./ Modal add Adress -->
