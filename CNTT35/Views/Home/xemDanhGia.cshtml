
@{
    ViewBag.Title = "xemDanhGia";
    int stt = 0;
}
@using PagedList.Mvc;
@using PagedList;
@model IPagedList<CNTT35.Data.getPhanHoiID_Result>
<section class="checkout spad">

    <div class="container">
        @{
            var parameter = Request.QueryString["ac2"];
            //Check parameter here and display Message
            if (parameter == "updatethatbai")
            {
                <div class="alert alert-success alert-dismissable" style="text-align:center">
                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i>Update Thất bại!thử lại </strong>
                </div>
            }
        }


        <div class="checkout__form">
            <h4>Danh sách đánh giá các sản phẩm</h4>


        </div>
    </div>
    <div class="container">

        <div class="container table-responsive py-5">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col" style="background-color: #007B5E !important;">STT</th>
                        <th scope="col" style="background-color: #007B5E !important;">Tên sản phẩm</th>
                        <th scope="col" style="background-color: #007B5E !important;">Họ tên</th>
                        <th scope="col" style="background-color: #007B5E !important;">Nội dung</th>
                        <th scope="col" style="background-color: #007B5E !important;">Chất lượng sản phẩm</th>
                        <th scope="col" style="background-color: #007B5E !important;">Đúng với mô tả</th>
                        <th scope="col" style="background-color: #007B5E !important;">Số sao</th>
                        <th scope="col" style="background-color: #007B5E !important;">Ngày đánh giá</th>
                        <th scope="col" style="background-color: #007B5E !important;">Chức năng</th>


                    </tr>
                </thead>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        stt++;
                        <tbody>
                            <tr>
                                <th scope="row">@stt</th>
                                <td>@item.TENSP</td>
                                <td>@item.HoTenDG</td>
                                <td>@item.NOIDUNG</td>
                                <td>@item.CHATLUONGSANPHAM</td>
                                <td>@item.DUNGVOIMOTA</td>
                                <td>@item.RATE</td>
                                <td>@item.NGAYPHANHOI.Value.ToShortDateString()</td>
                                <td style="display: flex; justify-content: space-around;">
                                    <a data-toggle="modal"
                                       data-target="#@item.IDPHANHOI">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#007B5E" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z" />
                                        </svg>
                                    </a>
                                    <a href="/Home/XoaPH/@item.IDPHANHOI" onclick="return confirmAction()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="red" class="bi bi-x" viewBox="0 0 16 16">
                                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                        </svg>
                                    </a>
                                    <script type="text/javascript">
                                        function confirmAction() {
                                            return confirm("Bạn thật sự muốn xoá Đánh Giá này?")
                                        }</script>
                                </td>

                            </tr>
                        </tbody>
                    }
                }
            </table>
        </div>
        <div class="product__pagination">
            @Html.PagedListPager(Model, page => Url.Action("xemDanhGia", new { page }))
        </div>
    </div>

    <div class="col-lg-12 container">
        <div class="shoping__cart__btns">
            <a href="/Product" class="primary-btn cart-btn">Tiếp tục mua sắm</a>
            <a href="/Home" class="primary-btn cart-btn cart-btn-right" style="margin-left: 2rem;">

                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                </svg>
                Quay về trang chủ
            </a>
        </div>
    </div>
</section>


<!-- Modal Edit Adress-->
@foreach (var i in Model)
{
    <div class="modal fade"
         id="@i.IDPHANHOI"
         tabindex="-1"
         role="dialog"
         aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            @using (Html.BeginForm("EditPhanHoi/" + i.IDPHANHOI, "Home", FormMethod.Post))
            {
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Chỉnh sửa đánh giá</h5>
                        <button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="sl-container">
                            <div class="sl-wrapper">
                                <div class="sl-vertical social-wrap oxi_icon_center login">

                                </div>
                            </div>
                        </div>

                        <div class="form-group">

                            <input placeholder="Họ tên" class="form-control custom-input" name="update-yourname" id="update-yourname" value="@i.HoTenDG" />
                        </div>
                        <div class="form-group">

                            <input placeholder="Nội dung" class="form-control custom-input" name="update-content" id="update-content" value="@i.NOIDUNG" />
                        </div>

                        <div class="form-group">

                            <input placeholder="Chất lượng sản phẩm" class="form-control custom-input" name="update-quality" id="update-quality" value="@i.CHATLUONGSANPHAM" />
                        </div>
                        <div class="form-group">

                            <input placeholder="Đúng với mô tả" class="form-control custom-input" name="update-describe" id="update-describe" value="@i.DUNGVOIMOTA" />
                        </div>
                        <div class="form-group">

                            <input placeholder="số sao" class="form-control custom-input" name="update-star" id="update-star" value="@i.RATE" />
                        </div>
                         <div class="form-group">
                           <h6> Thay đổi đánh giá sao</h6>
                           <div class="rating-css">
                            <div class="star-icon">
                                <input type="radio" name="rating1" id="rating1" value="1">
                                <label class="bi bi-star-fill" for="rating1"></label>
                                <input type="radio" name="rating1" id="rating2" value="2">
                                <label class="bi bi-star-fill" for="rating2"></label>
                                <input type="radio" name="rating1" id="rating3" value="3">
                                <label class="bi bi-star-fill" for="rating3"></label>
                                <input type="radio" name="rating1" id="rating4" value="4">
                                <label class="bi bi-star-fill" for="rating4"></label>
                                <input type="radio" name="rating1" id="rating5" value="5">
                                <label class="bi bi-star-fill" for="rating5"></label>

                          </div>
                         </div>
                        </div>


                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">
                            Trở lại
                        </button>
                        <button type="submit" class="btn btn-primary" style="background: #007B5E; color:#fff;">Hoàn thành</button>
                    </div>
                </div>

            }

        </div>
    </div>
}
<!-- ./ Modal Edit Adress -->
